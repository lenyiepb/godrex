# ─────────────────────────────────────────────────────────────────────────────
# Godrex Capital — Environment Variables
# Copy this file to .env.local and fill in all values before running.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/godrex_db?schema=public

# ── NextAuth.js ───────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_strong_random_secret_min_32_chars

# ── Market Data (Twelve Data) ─────────────────────────────────────────────────
# Free tier: 800 API calls/day. Upgrade for production.
# https://twelvedata.com
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ── Alternative: Alpha Vantage ────────────────────────────────────────────────
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ── Payment Provider (Stripe) ─────────────────────────────────────────────────
# https://stripe.com/docs — Use test keys during development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ── Email (Resend) ────────────────────────────────────────────────────────────
# https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@godrexcapital.com

# ── File Storage (Supabase — for KYC documents) ───────────────────────────────
# https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
KYC_BUCKET_NAME=kyc-documents

# ── 2FA (TOTP) ────────────────────────────────────────────────────────────────
TOTP_ISSUER=GodrexCapital
# No additional key needed — generated per-user and stored hashed in DB

# ── Security ──────────────────────────────────────────────────────────────────
# AES-256 key for encrypting sensitive fields at rest (32 bytes, hex-encoded)
FIELD_ENCRYPTION_KEY=your_32_byte_hex_encoded_key_here

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@godrexcapital.com

# ── GeoIP / Country blocking ──────────────────────────────────────────────────
# Used by middleware to block restricted jurisdictions
# MaxMind GeoLite2 or similar — optional, can use Cloudflare headers
GEOIP_API_KEY=your_geoip_provider_key_here
