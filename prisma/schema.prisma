// Prisma schema for Godrex Capital
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum AccountType {
  STANDARD
  PRO
  VIP
  DEMO
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

// ── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  // Hashed with bcrypt — NEVER store plaintext
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  country         String
  dateOfBirth     DateTime
  address         String?
  city            String?
  postcode        String?

  // 2FA
  totpSecret      String?   // encrypted at rest
  totpEnabled     Boolean   @default(false)

  // Roles & status
  isAdmin         Boolean   @default(false)
  isActive        Boolean   @default(true)
  marketingConsent Boolean  @default(false)

  // KYC
  kycStatus       KycStatus @default(PENDING)
  kycReviewedAt   DateTime?
  kycReviewedBy   String?

  // Relations
  sessions        Session[]
  accounts        TradingAccount[]
  kycDocuments    KycDocument[]
  transactions    Transaction[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model TradingAccount {
  id          String       @id @default(cuid())
  userId      String
  accountType AccountType
  currency    String       @default("USD")
  balance     Decimal      @default(0) @db.Decimal(18, 2)
  equity      Decimal      @default(0) @db.Decimal(18, 2)
  isActive    Boolean      @default(true)
  isDemo      Boolean      @default(false)

  user        User         @relation(fields: [userId], references: [id])
  orders      Order[]
  transactions Transaction[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model KycDocument {
  id           String   @id @default(cuid())
  userId       String
  documentType String   // "id_front", "id_back", "proof_of_address"
  storageUrl   String   // Supabase storage path (not a public URL)
  mimeType     String
  status       String   @default("pending")
  reviewNotes  String?
  user         User     @relation(fields: [userId], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([userId])
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  accountId       String
  type            TransactionType
  amount          Decimal           @db.Decimal(18, 2)
  currency        String            @default("USD")
  status          TransactionStatus @default(PENDING)
  paymentProvider String?           // "stripe", "bank_transfer", etc.
  providerRef     String?           // External reference (e.g. Stripe payment intent ID)
  notes           String?
  processedAt     DateTime?

  user            User           @relation(fields: [userId], references: [id])
  account         TradingAccount @relation(fields: [accountId], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([accountId])
}

model Order {
  id           String      @id @default(cuid())
  accountId    String
  symbol       String
  side         OrderSide
  lots         Decimal     @db.Decimal(10, 4)
  openPrice    Decimal     @db.Decimal(18, 6)
  closePrice   Decimal?    @db.Decimal(18, 6)
  stopLoss     Decimal?    @db.Decimal(18, 6)
  takeProfit   Decimal?    @db.Decimal(18, 6)
  commission   Decimal     @default(0) @db.Decimal(10, 4)
  swap         Decimal     @default(0) @db.Decimal(10, 4)
  profitLoss   Decimal?    @db.Decimal(18, 2)
  status       OrderStatus @default(OPEN)

  openedAt     DateTime    @default(now())
  closedAt     DateTime?

  account      TradingAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([symbol])
}
